    <!-- ======== Scripts ======== -->
    <script is:inline>
      (() => {
        // --- Theme Toggle ---
        const widget = document.querySelector("[data-theme-widget]");
        if (!widget) return;

        const btn = widget.querySelector("button");
        const menu = widget.querySelector("ul");
        const label = widget.querySelector("[data-theme-label]");
        const root = document.documentElement;
        const storageKey = "rye-theme-mode";
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        function currentMode() {
          try {
            const s = localStorage.getItem(storageKey);
            if (s === "light" || s === "dark" || s === "system") return s;
          } catch {}
          return "system";
        }

        function applyMode(mode) {
          const resolved =
            mode === "system" ? (media.matches ? "dark" : "light") : mode;
          root.setAttribute("data-theme-mode", mode);
          root.setAttribute("data-theme", resolved);
          label.textContent =
            mode.charAt(0).toUpperCase() + mode.slice(1);
          try {
            localStorage.setItem(storageKey, mode);
          } catch {}

          menu.querySelectorAll("li").forEach((li) => {
            li.setAttribute(
              "aria-selected",
              li.dataset.value === mode ? "true" : "false"
            );
          });
        }

        // Init label
        const init = currentMode();
        label.textContent =
          init.charAt(0).toUpperCase() + init.slice(1);
        applyMode(init);

        btn.addEventListener("click", () => {
          const open = menu.hidden;
          menu.hidden = !open;
          btn.setAttribute("aria-expanded", open ? "true" : "false");
        });

        menu.addEventListener("click", (e) => {
          const li = e.target.closest("li");
          if (!li || !li.dataset.value) return;
          applyMode(li.dataset.value);
          menu.hidden = true;
          btn.setAttribute("aria-expanded", "false");
        });

        document.addEventListener("click", (e) => {
          if (!widget.contains(e.target)) {
            menu.hidden = true;
            btn.setAttribute("aria-expanded", "false");
          }
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && !menu.hidden) {
            menu.hidden = true;
            btn.setAttribute("aria-expanded", "false");
            btn.focus();
          }
        });

        if (typeof media.addEventListener === "function") {
          media.addEventListener("change", () => {
            if (currentMode() === "system") applyMode("system");
          });
        }

        // --- Custom Selects ---
        document.querySelectorAll("[data-select]").forEach((sel) => {
          const trigger = sel.querySelector(".ds-select-trigger");
          const dropdown = sel.querySelector(".ds-select-menu");
          const valueSpan = trigger.querySelector("span");

          trigger.addEventListener("click", () => {
            const open = dropdown.hidden;
            dropdown.hidden = !open;
            trigger.setAttribute("aria-expanded", open ? "true" : "false");
          });

          dropdown.addEventListener("click", (e) => {
            const opt = e.target.closest("[role='option']");
            if (!opt) return;

            dropdown
              .querySelectorAll("[role='option']")
              .forEach((o) => o.setAttribute("aria-selected", "false"));
            opt.setAttribute("aria-selected", "true");
            valueSpan.textContent = opt.textContent.trim();
            dropdown.hidden = true;
            trigger.setAttribute("aria-expanded", "false");
          });

          document.addEventListener("click", (e) => {
            if (!sel.contains(e.target)) {
              dropdown.hidden = true;
              trigger.setAttribute("aria-expanded", "false");
            }
          });
        });
      })();
    </script>
