{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_type",
    "schema_version",
    "source_set",
    "scenario",
    "latest_run_id",
    "latest_event_type",
    "latest_ingest_status",
    "latest_lineage",
    "latest_mapping",
    "latest_destination_table"
  ],
  "properties": {
    "schema_type": { "const": "rye.tabular_intake.row_node.v2" },
    "schema_version": { "const": 2 },
    "source_set": {
      "type": "object",
      "required": ["group_key", "primary", "sources", "row_count"],
      "properties": {
        "group_key": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "primary": {
          "type": "object",
          "required": ["path", "format", "table_name", "sheet_name", "header_row", "row_number", "record_number"],
          "properties": {
            "path": { "type": "string" },
            "format": { "enum": ["csv", "xlsx"] },
            "table_name": { "type": "string" },
            "sheet_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "header_row": { "type": "integer", "minimum": 1 },
            "row_number": { "type": "integer", "minimum": 1 },
            "record_number": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "format", "table_name", "sheet_name", "header_row", "row_number", "record_number"],
            "properties": {
              "path": { "type": "string" },
              "format": { "enum": ["csv", "xlsx"] },
              "table_name": { "type": "string" },
              "sheet_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "header_row": { "type": "integer", "minimum": 1 },
              "row_number": { "type": "integer", "minimum": 1 },
              "record_number": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "row_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "scenario": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "latest_run_id": { "type": "string" },
    "latest_event_type": {
      "enum": [
        "rye_tabular_intake_row_extracted",
        "rye_tabular_intake_row_mapped",
        "rye_tabular_intake_row_staged"
      ]
    },
    "latest_ingest_status": { "type": "string" },
    "latest_lineage": {
      "type": "array",
      "items": { "type": "string" }
    },
    "latest_mapping": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "latest_destination_table": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
  },
  "additionalProperties": false
}
