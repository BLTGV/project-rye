{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_type",
    "schema_version",
    "kind",
    "node_type",
    "label",
    "source",
    "lineage",
    "properties",
    "run_id",
    "scenario",
    "payload_hash",
    "recorded_via"
  ],
  "properties": {
    "schema_type": { "const": "rye.tabular_intake.stage_record_claim.v1" },
    "schema_version": { "const": 1 },
    "kind": { "const": "rye_stage_record" },
    "node_type": { "type": "string" },
    "label": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["path", "format", "table_name", "sheet_name", "header_row", "row_number", "record_number"],
      "properties": {
        "path": { "type": "string" },
        "format": { "enum": ["csv", "xlsx"] },
        "table_name": { "type": "string" },
        "sheet_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "header_row": { "type": "integer", "minimum": 1 },
        "row_number": { "type": "integer", "minimum": 1 },
        "record_number": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "required": [
        "schema_type",
        "schema_version",
        "ingest_status",
        "source_format",
        "source_path",
        "source_table",
        "source_sheet",
        "source_row_number"
      ],
      "properties": {
        "schema_type": { "const": "rye.tabular_intake.stage_properties.v1" },
        "schema_version": { "const": 1 },
        "ingest_status": { "type": "string" },
        "source_format": { "enum": ["csv", "xlsx"] },
        "source_path": { "type": "string" },
        "source_table": { "type": "string" },
        "source_sheet": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "source_row_number": { "type": "integer", "minimum": 1 },
        "raw_fields": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          }
        },
        "destination_table": { "type": "string" },
        "mapping": { "type": "string" },
        "mapped_record": { "type": "object" },
        "mapping_issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "run_id": { "type": "string" },
    "scenario": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "payload_hash": { "type": "string" },
    "recorded_via": { "const": "tabular_commit_rye.mts" }
  },
  "additionalProperties": false
}
