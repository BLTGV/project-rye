{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_type",
    "schema_version",
    "kind",
    "node_type",
    "label",
    "source_set",
    "lineage",
    "properties",
    "run_id",
    "scenario",
    "payload_hash",
    "recorded_via"
  ],
  "properties": {
    "schema_type": { "const": "rye.tabular_intake.stage_record_claim.v2" },
    "schema_version": { "const": 2 },
    "kind": { "const": "rye_stage_record" },
    "node_type": { "type": "string" },
    "label": { "type": "string" },
    "source_set": {
      "type": "object",
      "required": ["group_key", "primary", "sources", "row_count"],
      "properties": {
        "group_key": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "primary": {
          "type": "object",
          "required": ["path", "format", "table_name", "sheet_name", "header_row", "row_number", "record_number"],
          "properties": {
            "path": { "type": "string" },
            "format": { "enum": ["csv", "xlsx"] },
            "table_name": { "type": "string" },
            "sheet_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "header_row": { "type": "integer", "minimum": 1 },
            "row_number": { "type": "integer", "minimum": 1 },
            "record_number": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "format", "table_name", "sheet_name", "header_row", "row_number", "record_number"],
            "properties": {
              "path": { "type": "string" },
              "format": { "enum": ["csv", "xlsx"] },
              "table_name": { "type": "string" },
              "sheet_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
              "header_row": { "type": "integer", "minimum": 1 },
              "row_number": { "type": "integer", "minimum": 1 },
              "record_number": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "row_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "required": [
        "schema_type",
        "schema_version",
        "ingest_status",
        "source_set"
      ],
      "properties": {
        "schema_type": { "const": "rye.tabular_intake.stage_properties.v2" },
        "schema_version": { "const": 2 },
        "ingest_status": { "type": "string" },
        "source_set": {
          "type": "object",
          "required": ["group_key", "primary", "sources", "row_count"],
          "properties": {
            "group_key": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
            "primary": {
              "type": "object",
              "required": ["path", "format", "table_name", "sheet_name", "header_row", "row_number", "record_number"],
              "properties": {
                "path": { "type": "string" },
                "format": { "enum": ["csv", "xlsx"] },
                "table_name": { "type": "string" },
                "sheet_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                "header_row": { "type": "integer", "minimum": 1 },
                "row_number": { "type": "integer", "minimum": 1 },
                "record_number": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["path", "format", "table_name", "sheet_name", "header_row", "row_number", "record_number"],
                "properties": {
                  "path": { "type": "string" },
                  "format": { "enum": ["csv", "xlsx"] },
                  "table_name": { "type": "string" },
                  "sheet_name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
                  "header_row": { "type": "integer", "minimum": 1 },
                  "row_number": { "type": "integer", "minimum": 1 },
                  "record_number": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            },
            "row_count": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "raw_fields": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [{ "type": "string" }, { "type": "null" }]
          }
        },
        "destination_table": { "type": "string" },
        "mapping": { "type": "string" },
        "mapped_record": { "type": "object" },
        "mapping_issues": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "run_id": { "type": "string" },
    "scenario": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "payload_hash": { "type": "string" },
    "recorded_via": { "const": "tabular_commit_rye.mts" }
  },
  "additionalProperties": false
}
