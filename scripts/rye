#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${RYE_ENV_FILE:-${ROOT_DIR}/.rye.env}"
LOG_DIR="${RYE_LOG_DIR:-${ROOT_DIR}/.rye}"
INSTALL_LOG="${RYE_INSTALL_LOG:-${LOG_DIR}/install.log}"
DEFAULT_PROFILES="${RYE_PROFILES:-crm,pm}"
DEFAULT_SCHEMA="${RYE_SCHEMA:-rye}"
OUTPUT_JSON=0
QUIET=0
CLI_DB_URL_SET=0
CLI_SCHEMA_SET=0

usage() {
  cat <<'EOF'
Usage:
  ./scripts/rye init local [--fresh] [--seed] [--profiles crm,pm]
  ./scripts/rye init remote --db-url <postgresql://...> [--seed] [--profiles crm,pm]
  ./scripts/rye onboard create --label <name> --purpose <text> [--key <slug>] [--owner <name>]
                               [--in-scope <text>] [--out-of-scope <text>]
  ./scripts/rye status [--json]
  ./scripts/rye doctor [--json]
  ./scripts/rye catalog plugins|skills|capabilities [--json]
  ./scripts/rye context [--scope <uuid-or-key>] [--json]
  ./scripts/rye sources inventory|pending-context [--json]
  ./scripts/rye agents create|grant|issue-token|revoke-token|list|audit [--json]

Aliases:
  ./scripts/rye local [--fresh] [--seed] [--profiles crm,pm]
  ./scripts/rye remote --db-url <postgresql://...> [--seed] [--profiles crm,pm]
  ./scripts/rye onboard --label <name> --purpose <text> [...]
  ./scripts/rye plugins [sync|list]

Global options:
  --db-url <postgresql://...>   Use this database instead of .rye.env
  --schema <schema>             Rye schema name. Default: rye
  --env-file <path>             Local Rye env file. Default: .rye.env
                                (written automatically by init; no need to create it by hand)
  --json                        Return machine-readable JSON where supported
  --quiet                       Reduce non-error output

Onboard defaults (when flags are omitted):
  --in-scope       "initial limited workflow"
  --out-of-scope   "full organization-wide rollout|automatic source ingestion|
                    promotion of facts without review"
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

info() {
  [[ "$QUIET" -eq 1 ]] || echo "==> $*"
}

run_logged() {
  local label="$1"
  shift

  mkdir -p "$LOG_DIR"
  info "$label"
  if "$@" > "$INSTALL_LOG" 2>&1; then
    [[ "$QUIET" -eq 1 ]] || echo "    ok (log: $INSTALL_LOG)"
    return
  fi

  echo "    failed (log: $INSTALL_LOG)" >&2
  echo >&2
  tail -n 80 "$INSTALL_LOG" >&2 || true
  exit 1
}

shell_quote() {
  printf "%q" "$1"
}

sql_literal() {
  local value="${1//\'/\'\'}"
  printf "'%s'" "$value"
}

redact_db_url() {
  sed -E 's#(postgres(ql)?://[^:/@]+:)[^@]*@#\1****@#' <<<"$1"
}

parse_global_args() {
  ARGS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --db-url)
        DATABASE_URL="${2:-}"
        RYE_DB_MODE="remote"
        unset RYE_CONTAINER_DATABASE_URL || true
        export DATABASE_URL RYE_DB_MODE
        CLI_DB_URL_SET=1
        shift 2
        ;;
      --schema)
        RYE_SCHEMA="${2:-}"
        DEFAULT_SCHEMA="$RYE_SCHEMA"
        export RYE_SCHEMA
        CLI_SCHEMA_SET=1
        shift 2
        ;;
      --env-file)
        ENV_FILE="${2:-}"
        shift 2
        ;;
      --json)
        OUTPUT_JSON=1
        shift
        ;;
      --quiet)
        QUIET=1
        shift
        ;;
      *)
        ARGS+=("$1")
        shift
        ;;
    esac
  done
}

write_env() {
  local mode="$1"
  local db_url="$2"
  local profiles="$3"
  local schema="$4"
  local container_db_url="${5:-}"

  {
    echo "# Created by ./scripts/rye. This file is local config; do not commit secrets."
    echo "export DATABASE_URL=$(shell_quote "$db_url")"
    echo "export RYE_PROFILES=$(shell_quote "$profiles")"
    echo "export RYE_SCHEMA=$(shell_quote "$schema")"
    echo "export RYE_DB_MODE=$(shell_quote "$mode")"
    if [[ -n "$container_db_url" ]]; then
      echo "export RYE_CONTAINER_DATABASE_URL=$(shell_quote "$container_db_url")"
    fi
  } > "$ENV_FILE"
}

load_env_if_present() {
  local explicit_db="${DATABASE_URL:-}"
  local explicit_schema="${RYE_SCHEMA:-}"

  if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
  fi

  if [[ "$CLI_DB_URL_SET" -eq 1 ]]; then
    DATABASE_URL="$explicit_db"
    RYE_DB_MODE="remote"
    unset RYE_CONTAINER_DATABASE_URL || true
    export DATABASE_URL RYE_DB_MODE
  fi

  if [[ "$CLI_SCHEMA_SET" -eq 1 ]]; then
    RYE_SCHEMA="$explicit_schema"
    DEFAULT_SCHEMA="$explicit_schema"
    export RYE_SCHEMA
  fi
}

find_compose_cmd() {
  if docker compose version >/dev/null 2>&1; then
    COMPOSE_CMD=(docker compose)
    return
  fi

  if command -v docker-compose >/dev/null 2>&1; then
    COMPOSE_CMD=(docker-compose)
    return
  fi

  die "Docker Compose is required for local Rye."
}

compose() {
  "${COMPOSE_CMD[@]}" -f "${RYE_DOCKER_COMPOSE_FILE:-${ROOT_DIR}/docker-compose.yml}" "$@"
}

wait_for_db() {
  local attempts=60

  info "Waiting for the database to be ready (up to ${attempts}s)..."
  for ((i=1; i<=attempts; i++)); do
    if compose exec -T rye-db pg_isready -U "${POSTGRES_USER:-rye}" -d "${POSTGRES_DB:-rye}" >/dev/null 2>&1; then
      return
    fi
    if (( i % 10 == 0 )); then
      info "Still waiting for the database (${i}s)..."
    fi
    sleep 1
  done

  compose logs rye-db || true
  die "Postgres did not become ready in time."
}

psql_run() {
  local sql="$1"
  shift
  load_env_if_present

  if [[ "${RYE_DB_MODE:-}" == "local" ]]; then
    find_compose_cmd
    compose exec -T rye-db psql "${RYE_CONTAINER_DATABASE_URL:-postgresql://rye:rye@127.0.0.1:5432/rye}" -v ON_ERROR_STOP=1 "$@" <<<"$sql"
    return
  fi

  local db_url="${DATABASE_URL:-}"
  [[ -n "$db_url" ]] || die "DATABASE_URL is not set. Run ./scripts/rye init local or ./scripts/rye init remote first."
  command -v psql >/dev/null 2>&1 || die "psql is required for remote database commands."
  psql "$db_url" -v ON_ERROR_STOP=1 "$@" <<<"$sql"
}

psql_exec() {
  psql_run "$1"
}

psql_json() {
  psql_run "$1" -qAt
}

local_install() {
  local fresh="$1"
  local seed="$2"
  local profiles="$3"
  local schema="$4"
  local container_db_url
  local install_cmd

  find_compose_cmd

  if [[ "$fresh" -eq 1 ]]; then
    compose down -v --remove-orphans
  fi

  compose up -d rye-db
  wait_for_db

  container_db_url="postgresql://${POSTGRES_USER:-rye}:${POSTGRES_PASSWORD:-rye}@127.0.0.1:5432/${POSTGRES_DB:-rye}"
  install_cmd="cd /workspace && DATABASE_URL=$(shell_quote "$container_db_url") ./scripts/install.sh --profiles $(shell_quote "$profiles") --schema $(shell_quote "$schema")"

  if [[ "$seed" -eq 1 ]]; then
    install_cmd+=" --seed"
  fi

  compose exec -T rye-db bash -lc "$install_cmd"
}

sync_metadata() {
  load_env_if_present

  if [[ "${RYE_DB_MODE:-}" == "local" ]]; then
    find_compose_cmd
    compose exec -T rye-db bash -lc "cd /workspace && ./scripts/sync_plugin_metadata.sh --db-url $(shell_quote "${RYE_CONTAINER_DATABASE_URL:-postgresql://rye:rye@127.0.0.1:5432/rye}") --schema $(shell_quote "${RYE_SCHEMA:-rye}")"
    return
  fi

  local db_url="${DATABASE_URL:-}"
  [[ -n "$db_url" ]] || die "DATABASE_URL is not set. Run ./scripts/rye init local or ./scripts/rye init remote first."
  command -v psql >/dev/null 2>&1 || die "psql is required for remote database commands."
  "${ROOT_DIR}/scripts/sync_plugin_metadata.sh" --db-url "$db_url" --schema "${RYE_SCHEMA:-rye}"
}

slugify() {
  echo "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | sed -E 's/^-?$/scope/'
}

scope_sql_expr() {
  local scope="${1:-}"
  if [[ -z "$scope" ]]; then
    printf 'NULL::uuid'
    return
  fi

  if [[ "$scope" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
    printf '%s::uuid' "$(sql_literal "$scope")"
    return
  fi

  printf '(SELECT id FROM rye.nodes WHERE archived_at IS NULL AND node_type = %s AND external_source = %s AND external_id = %s LIMIT 1)' \
    "$(sql_literal "onboarding_scope")" \
    "$(sql_literal "rye_onboarding_scope")" \
    "$(sql_literal "$scope")"
}

cmd_local() {
  local fresh=0
  local seed=0
  local profiles="$DEFAULT_PROFILES"
  local schema="$DEFAULT_SCHEMA"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fresh)
        fresh=1
        shift
        ;;
      --seed)
        seed=1
        shift
        ;;
      --profiles)
        profiles="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown local option: $1"
        ;;
    esac
  done

  run_logged "Installing Rye locally in Docker" local_install "$fresh" "$seed" "$profiles" "$schema"

  local host_port="${RYE_POSTGRES_PORT:-54329}"
  local db_url="postgresql://${POSTGRES_USER:-rye}:${POSTGRES_PASSWORD:-rye}@127.0.0.1:${host_port}/${POSTGRES_DB:-rye}"
  local container_db_url="postgresql://${POSTGRES_USER:-rye}:${POSTGRES_PASSWORD:-rye}@127.0.0.1:5432/${POSTGRES_DB:-rye}"
  write_env "local" "$db_url" "$profiles" "$schema" "$container_db_url"

  [[ "$QUIET" -eq 1 ]] && return
  cat <<EOF

Rye is installed locally.
Database: $(redact_db_url "$db_url")
Config:   $ENV_FILE

Next:
  ./scripts/rye onboard create --label "First Scope" --purpose "Describe the limited workflow Rye should assist first."
EOF
}

cmd_remote() {
  local db_url="${DATABASE_URL:-}"
  local seed=0
  local profiles="$DEFAULT_PROFILES"
  local schema="$DEFAULT_SCHEMA"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --seed)
        seed=1
        shift
        ;;
      --profiles)
        profiles="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown remote option: $1"
        ;;
    esac
  done

  [[ -n "$db_url" ]] || die "remote requires --db-url or DATABASE_URL."
  command -v psql >/dev/null 2>&1 || die "psql is required for remote installs."

  local args=(--db-url "$db_url" --profiles "$profiles" --schema "$schema")
  if [[ "$seed" -eq 1 ]]; then
    args+=(--seed)
  fi

  run_logged "Installing Rye into remote database" "${ROOT_DIR}/scripts/install.sh" "${args[@]}"
  write_env "remote" "$db_url" "$profiles" "$schema"

  [[ "$QUIET" -eq 1 ]] && return
  cat <<EOF

Rye is installed in the remote database.
Database: $(redact_db_url "$db_url")
Config:   $ENV_FILE

Next:
  ./scripts/rye onboard create --label "First Scope" --purpose "Describe the limited workflow Rye should assist first."
EOF
}

cmd_init() {
  local command="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    local)
      cmd_local "$@"
      ;;
    remote)
      cmd_remote "$@"
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      die "Unknown init command: $command"
      ;;
  esac
}

cmd_onboard() {
  if [[ "${1:-}" == "create" ]]; then
    shift
  fi

  local label=""
  local purpose=""
  local key=""
  local owner="${USER:-}"
  local in_scope="initial limited workflow"
  local out_of_scope="full organization-wide rollout|automatic source ingestion|promotion of facts without review"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --label)
        label="${2:-}"
        shift 2
        ;;
      --purpose)
        purpose="${2:-}"
        shift 2
        ;;
      --key)
        key="${2:-}"
        shift 2
        ;;
      --owner)
        owner="${2:-}"
        shift 2
        ;;
      --in-scope)
        in_scope="${2:-}"
        shift 2
        ;;
      --out-of-scope)
        out_of_scope="${2:-}"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown onboard option: $1"
        ;;
    esac
  done

  [[ -n "$label" ]] || die "onboard requires --label."
  [[ -n "$purpose" ]] || die "onboard requires --purpose."
  if [[ -z "$key" ]]; then
    key="$(slugify "$label")"
  fi

  run_logged "Syncing Rye metadata" sync_metadata

  local key_sql label_sql purpose_sql owner_sql in_scope_sql out_of_scope_sql
  key_sql="$(sql_literal "$key")"
  label_sql="$(sql_literal "$label")"
  purpose_sql="$(sql_literal "$purpose")"
  owner_sql="$(sql_literal "$owner")"
  in_scope_sql="$(sql_literal "$in_scope")"
  out_of_scope_sql="$(sql_literal "$out_of_scope")"

  local sql
  sql="$(cat <<SQL
SET search_path = rye, public, pg_catalog;
DO \$\$
DECLARE
    v_scope uuid;
BEGIN
    PERFORM set_config('app.current_role', 'admin', true);
    PERFORM set_config('app.current_user_id', 'rye:first-run', true);
    PERFORM set_config('app.current_teams', 'system', true);

    v_scope := create_onboarding_scope(
        p_scope_key := ${key_sql},
        p_label     := ${label_sql},
        p_purpose   := ${purpose_sql},
        p_boundary  := jsonb_build_object(
            'in_scope', to_jsonb(string_to_array(${in_scope_sql}, '|')),
            'out_of_scope', to_jsonb(string_to_array(${out_of_scope_sql}, '|'))
        ),
        p_owner     := ${owner_sql},
        p_created_by := 'rye:first-run',
        p_properties := jsonb_build_object('created_by_command', './scripts/rye onboard create')
    );

    PERFORM record_scope_policy(v_scope, 'expected_contexts', jsonb_build_object(
        'contexts', jsonb_build_array(),
        'meaning', 'No source-specific expected contexts have been confirmed yet.'
    ), 'default', 'rye:first-run');

    PERFORM record_scope_policy(v_scope, 'holding_context', jsonb_build_object(
        'context_id', 'needs_context',
        'label', 'Needs Context'
    ), 'default', 'rye:first-run');

    PERFORM record_scope_policy(v_scope, 'unexpected_context_policy', jsonb_build_object(
        'action', 'create_context_gap_candidate'
    ), 'default', 'rye:first-run');

    PERFORM record_scope_policy(v_scope, 'retention_policy', jsonb_build_object(
        'default_retention_class', 'review_window',
        'low_signal', 'collapsed',
        'future_pruning_needed', true
    ), 'default', 'rye:first-run');

    PERFORM record_scope_policy(v_scope, 'evidence_policy', jsonb_build_object(
        'promotion_requires_review', true,
        'metadata_is_provenance_not_business_truth', true,
        'source_context_must_be_confirmed_before_default_routing', true
    ), 'default', 'rye:first-run');

    PERFORM record_scope_policy(v_scope, 'allowed_node_types', jsonb_build_object(
        'types', jsonb_build_array('source_account', 'source_container', 'source_item', 'review_context', 'knowledge_candidate', 'task', 'person', 'organization', 'system', 'department', 'policy', 'procedure')
    ), 'default', 'rye:first-run');

    PERFORM record_scope_policy(v_scope, 'allowed_edge_types', jsonb_build_object(
        'types', jsonb_build_array('contains_item', 'reviewed_under', 'supported_by', 'derived_from', 'promoted_to', 'scope_has_context_gap', 'scope_applies_to_source', 'scope_uses_profile', 'scope_uses_retrieval_channel', 'scope_enables_plugin')
    ), 'default', 'rye:first-run');

    PERFORM enable_plugin_for_scope(
        v_scope,
        'rye-source-context',
        'Source Context',
        coalesce((SELECT properties->'manifest' FROM nodes WHERE node_type = 'plugin' AND external_source = 'rye_plugin' AND external_id = 'rye-source-context' AND archived_at IS NULL LIMIT 1), '{}'::jsonb),
        'rye:first-run'
    );
    PERFORM enable_plugin_for_scope(
        v_scope,
        'rye-evidence-anchor',
        'Evidence Anchor',
        coalesce((SELECT properties->'manifest' FROM nodes WHERE node_type = 'plugin' AND external_source = 'rye_plugin' AND external_id = 'rye-evidence-anchor' AND archived_at IS NULL LIMIT 1), '{}'::jsonb),
        'rye:first-run'
    );
    PERFORM enable_plugin_for_scope(
        v_scope,
        'rye-org',
        'Organization Model',
        coalesce((SELECT properties->'manifest' FROM nodes WHERE node_type = 'plugin' AND external_source = 'rye_plugin' AND external_id = 'rye-org' AND archived_at IS NULL LIMIT 1), '{}'::jsonb),
        'rye:first-run'
    );
    PERFORM enable_plugin_for_scope(
        v_scope,
        'rye-project-management',
        'Project Management',
        coalesce((SELECT properties->'manifest' FROM nodes WHERE node_type = 'plugin' AND external_source = 'rye_plugin' AND external_id = 'rye-project-management' AND archived_at IS NULL LIMIT 1), '{}'::jsonb),
        'rye:first-run'
    );

    PERFORM activate_onboarding_scope(v_scope, 'rye:first-run');
END
\$\$;
SQL
)"

  info "Creating first onboarding scope"
  psql_exec "$sql"

  [[ "$QUIET" -eq 1 ]] && return
  cat <<EOF

Onboarding scope is active.
Scope key: $key

Next:
  Connect a source and classify it under this scope. Start with source metadata,
  not accepted business facts.
EOF
}

cmd_plugins() {
  local command="${1:-list}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$command" in
    sync)
      run_logged "Syncing Rye metadata" sync_metadata
      [[ "$QUIET" -eq 1 ]] || echo "Rye metadata synced."
      ;;
    list)
      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT rye.rye_plugin_catalog();"
      else
        catalog_plugins_table
      fi
      ;;
    -h|--help|help)
      cat <<'EOF'
Usage:
  ./scripts/rye plugins sync
  ./scripts/rye plugins list [--json]
EOF
      ;;
    *)
      die "Unknown plugins command: $command"
      ;;
  esac
}

catalog_plugins_table() {
  psql_exec "SET search_path = rye, public, pg_catalog;
SELECT
    label,
    external_id AS plugin_id,
    coalesce(properties->>'version', properties->'manifest'->>'version') AS version,
    coalesce(jsonb_array_length(properties->'contributes'->'node_types'), 0) AS node_types,
    coalesce(jsonb_array_length(properties->'contributes'->'edge_types'), 0) AS edge_types,
    coalesce(jsonb_array_length(properties->'contributes'->'assertion_types'), 0) AS assertion_types,
    coalesce(jsonb_array_length(properties->'contributes'->'event_types'), 0) AS event_types,
    coalesce(jsonb_array_length(properties->'contributes'->'artifact_types'), 0) AS artifact_types,
    coalesce(jsonb_array_length(properties->'capabilities'), 0) AS capabilities
FROM nodes
WHERE archived_at IS NULL
  AND node_type = 'plugin'
  AND external_source = 'rye_plugin'
ORDER BY external_id;"
}

catalog_skills_table() {
  psql_exec "SET search_path = rye, public, pg_catalog;
SELECT
    label,
    external_id AS skill_id,
    coalesce(properties->>'version', properties->'manifest'->>'version') AS version,
    properties->'install'->>'command' AS install_command,
    coalesce(jsonb_array_length(properties->'capabilities'), 0) AS capabilities
FROM nodes
WHERE archived_at IS NULL
  AND node_type = 'skill'
  AND external_source = 'rye_skill'
ORDER BY external_id;"
}

catalog_capabilities_table() {
  psql_exec "SET search_path = rye, public, pg_catalog;
WITH rows AS (
  SELECT jsonb_array_elements(rye_capability_catalog()->'capabilities') AS c
)
SELECT
  c->>'source_kind' AS source_kind,
  c->>'source_id' AS source_id,
  c->>'id' AS capability_id,
  c->>'kind' AS kind,
  c->>'read_only' AS read_only,
  c->>'label' AS label
FROM rows
ORDER BY source_kind, source_id, capability_id;"
}

cmd_catalog() {
  local topic="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$topic" in
    plugins)
      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT rye.rye_plugin_catalog();"
      else
        catalog_plugins_table
      fi
      ;;
    skills)
      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT rye.rye_skill_catalog();"
      else
        catalog_skills_table
      fi
      ;;
    capabilities)
      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT rye.rye_capability_catalog();"
      else
        catalog_capabilities_table
      fi
      ;;
    -h|--help|help|"")
      cat <<'EOF'
Usage:
  ./scripts/rye catalog plugins [--json]
  ./scripts/rye catalog skills [--json]
  ./scripts/rye catalog capabilities [--json]
EOF
      ;;
    *)
      die "Unknown catalog topic: $topic"
      ;;
  esac
}

cmd_status() {
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    psql_json "SELECT rye.rye_agent_context();"
    return
  fi

  psql_exec "SET search_path = rye, public, pg_catalog;
SELECT 'nodes' AS kind, node_type AS type, count(*)::text AS count
FROM nodes
WHERE archived_at IS NULL
GROUP BY node_type
UNION ALL
SELECT 'scopes' AS kind, n.label AS type, coalesce(a.claim->>'status', 'unknown') AS count
FROM nodes n
LEFT JOIN current_valid_assertions a
  ON a.subject_node_id = n.id
 AND a.assertion_type = 'scope_status'
WHERE n.archived_at IS NULL
  AND n.node_type = 'onboarding_scope'
UNION ALL
SELECT 'metadata' AS kind, 'plugins' AS type, count(*)::text AS count
FROM nodes
WHERE archived_at IS NULL AND node_type = 'plugin' AND external_source = 'rye_plugin'
UNION ALL
SELECT 'metadata' AS kind, 'skills' AS type, count(*)::text AS count
FROM nodes
WHERE archived_at IS NULL AND node_type = 'skill' AND external_source = 'rye_skill'
ORDER BY kind, type;"
}

cmd_doctor() {
  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    psql_json "SELECT jsonb_build_object(
  'database_reachable', true,
  'catalog', rye.rye_catalog(),
  'plugins', rye.rye_plugin_catalog()->'totals',
  'skills', rye.rye_skill_catalog()->'totals',
  'capabilities', rye.rye_capability_catalog()->'totals'
);"
    return
  fi

  psql_exec "SET search_path = rye, public, pg_catalog;
SELECT 'database' AS check, 'reachable' AS status
UNION ALL
SELECT 'plugins' AS check, (rye_plugin_catalog()->'totals'->>'plugins') AS status
UNION ALL
SELECT 'skills' AS check, (rye_skill_catalog()->'totals'->>'skills') AS status
UNION ALL
SELECT 'capabilities' AS check, (rye_capability_catalog()->'totals'->>'capabilities') AS status;"
}

cmd_context() {
  local scope=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="${2:-}"
        shift 2
        ;;
      -h|--help)
        cat <<'EOF'
Usage:
  ./scripts/rye context [--scope <uuid-or-key>] [--json]
EOF
        return
        ;;
      *)
        die "Unknown context option: $1"
        ;;
    esac
  done

  local scope_expr
  scope_expr="$(scope_sql_expr "$scope")"

  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    psql_json "SELECT rye.rye_agent_context(${scope_expr});"
    return
  fi

  psql_exec "SET search_path = rye, public, pg_catalog;
WITH ctx AS (
  SELECT rye_agent_context(${scope_expr}) AS j
),
active_scopes AS (
  SELECT jsonb_array_elements(j->'active_scopes') AS s FROM ctx
)
SELECT
  s->>'label' AS active_scope,
  s->>'scope_key' AS scope_key,
  s->>'status' AS status,
  s->>'purpose' AS purpose
FROM active_scopes
ORDER BY active_scope;

WITH ctx AS (
  SELECT rye_agent_context(${scope_expr}) AS j
)
SELECT
  j->'scope_selection'->>'mode' AS selection_mode,
  j->'scope_selection'->>'selected_scope_id' AS selected_scope_id,
  j->'scope_selection'->>'selected_scope_found' AS selected_scope_found,
  j->'plugins'->'totals'->>'plugins' AS plugins,
  j->'skills'->'totals'->>'skills' AS skills,
  j->'capabilities'->'totals'->>'capabilities' AS capabilities
FROM ctx;"
}

cmd_sources() {
  local command="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    inventory)
      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT rye.rye_source_inventory();"
      else
        psql_exec "SET search_path = rye, public, pg_catalog;
WITH rows AS (
  SELECT jsonb_array_elements(rye_source_inventory()) AS s
)
SELECT
  s->>'node_type' AS node_type,
  s->>'label' AS label,
  coalesce(s->>'confirmation_status', 'unknown') AS confirmation_status,
  s->>'source_item_count' AS source_items
FROM rows
ORDER BY node_type, label;"
      fi
      ;;
    pending-context)
      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT rye.rye_pending_context_confirmations();"
      else
        psql_exec "SET search_path = rye, public, pg_catalog;
WITH rows AS (
  SELECT jsonb_array_elements(rye_pending_context_confirmations()) AS s
)
SELECT
  s->>'node_type' AS node_type,
  s->>'label' AS label,
  s->>'external_source' AS external_source,
  s->>'external_id' AS external_id
FROM rows
ORDER BY node_type, label;"
      fi
      ;;
    -h|--help|help|"")
      cat <<'EOF'
Usage:
  ./scripts/rye sources inventory [--json]
  ./scripts/rye sources pending-context [--json]
EOF
      ;;
    *)
      die "Unknown sources command: $command"
      ;;
  esac
}

cmd_agents() {
  local command="${1:-}"
  [[ $# -gt 0 ]] && shift

  case "$command" in
    create)
      local key=""
      local label=""
      local runtime="codex-cli"
      local scope_ref=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --key)
            key="${2:-}"
            shift 2
            ;;
          --label)
            label="${2:-}"
            shift 2
            ;;
          --runtime)
            runtime="${2:-}"
            shift 2
            ;;
          --scope-ref|--scope)
            scope_ref="${2:-}"
            shift 2
            ;;
          -h|--help)
            cat <<'EOF'
Usage:
  ./scripts/rye agents create --key <agent-key> --label <name> [--runtime <runtime>] [--scope-ref <scope>]
EOF
            return
            ;;
          *)
            die "Unknown agents create option: $1"
            ;;
        esac
      done

      [[ -n "$key" ]] || die "agents create requires --key."
      [[ -n "$label" ]] || die "agents create requires --label."

      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT jsonb_build_object(
  'agent_id', rye.create_agent_identity($(sql_literal "$key"), $(sql_literal "$label"), $(sql_literal "$runtime"), nullif($(sql_literal "$scope_ref"), '')),
  'agent_key', rye.rye_slugify_key($(sql_literal "$key")),
  'label', $(sql_literal "$label"),
  'runtime', $(sql_literal "$runtime")
);"
        return
      fi

      psql_exec "SELECT rye.create_agent_identity($(sql_literal "$key"), $(sql_literal "$label"), $(sql_literal "$runtime"), nullif($(sql_literal "$scope_ref"), '')) AS agent_id;"
      ;;
    grant)
      local key=""
      local capability=""
      local domain_key=""
      local scope_ref=""
      local expires_at=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --key)
            key="${2:-}"
            shift 2
            ;;
          --capability)
            capability="${2:-}"
            shift 2
            ;;
          --domain|--domain-key)
            domain_key="${2:-}"
            shift 2
            ;;
          --scope-ref|--scope)
            scope_ref="${2:-}"
            shift 2
            ;;
          --expires-at)
            expires_at="${2:-}"
            shift 2
            ;;
          -h|--help)
            cat <<'EOF'
Usage:
  ./scripts/rye agents grant --key <agent-key> --capability <capability> [--domain <domain-key>] [--scope-ref <scope>] [--expires-at <iso-time>]
EOF
            return
            ;;
          *)
            die "Unknown agents grant option: $1"
            ;;
        esac
      done

      [[ -n "$key" ]] || die "agents grant requires --key."
      [[ -n "$capability" ]] || die "agents grant requires --capability."

      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT jsonb_build_object(
  'grant_id', rye.grant_agent_capability($(sql_literal "$key"), $(sql_literal "$capability"), nullif($(sql_literal "$domain_key"), ''), nullif($(sql_literal "$scope_ref"), ''), nullif($(sql_literal "$expires_at"), '')::timestamptz),
  'agent_key', rye.rye_slugify_key($(sql_literal "$key")),
  'capability', $(sql_literal "$capability"),
  'domain_key', rye.rye_slugify_key(nullif($(sql_literal "$domain_key"), '')),
  'scope_ref', nullif($(sql_literal "$scope_ref"), '')
);"
        return
      fi

      psql_exec "SELECT rye.grant_agent_capability($(sql_literal "$key"), $(sql_literal "$capability"), nullif($(sql_literal "$domain_key"), ''), nullif($(sql_literal "$scope_ref"), ''), nullif($(sql_literal "$expires_at"), '')::timestamptz) AS grant_id;"
      ;;
    issue-token)
      local key=""
      local label=""
      local expires_at=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --key)
            key="${2:-}"
            shift 2
            ;;
          --label)
            label="${2:-}"
            shift 2
            ;;
          --expires-at)
            expires_at="${2:-}"
            shift 2
            ;;
          -h|--help)
            cat <<'EOF'
Usage:
  ./scripts/rye agents issue-token --key <agent-key> [--label <label>] [--expires-at <iso-time>]
EOF
            return
            ;;
          *)
            die "Unknown agents issue-token option: $1"
            ;;
        esac
      done

      [[ -n "$key" ]] || die "agents issue-token requires --key."

      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT rye.issue_agent_token_record($(sql_literal "$key"), nullif($(sql_literal "$label"), ''), nullif($(sql_literal "$expires_at"), '')::timestamptz);"
        return
      fi

      psql_exec "SELECT
  issued->>'token_id' AS token_id,
  issued->>'token' AS one_time_token
FROM rye.issue_agent_token_record($(sql_literal "$key"), nullif($(sql_literal "$label"), ''), nullif($(sql_literal "$expires_at"), '')::timestamptz) AS issued;"
      echo "Token is shown once. Rye stores only its SHA-256 hash."
      ;;
    revoke-token)
      local token_id=""

      while [[ $# -gt 0 ]]; do
        case "$1" in
          --token-id)
            token_id="${2:-}"
            shift 2
            ;;
          -h|--help)
            cat <<'EOF'
Usage:
  ./scripts/rye agents revoke-token --token-id <uuid>
EOF
            return
            ;;
          *)
            die "Unknown agents revoke-token option: $1"
            ;;
        esac
      done

      [[ -n "$token_id" ]] || die "agents revoke-token requires --token-id."

      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT jsonb_build_object('token_id', $(sql_literal "$token_id"), 'revoked', rye.revoke_agent_token($(sql_literal "$token_id")::uuid, 'scripts/rye agents revoke-token'));"
        return
      fi

      psql_exec "SELECT rye.revoke_agent_token($(sql_literal "$token_id")::uuid, 'scripts/rye agents revoke-token') AS revoked;"
      ;;
    list)
      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "WITH cfg AS (SELECT set_config('app.current_role','admin',false))
SELECT jsonb_build_object(
  'agents', COALESCE(jsonb_agg(jsonb_build_object(
    'agent_id', ai.id,
    'agent_key', ai.agent_key,
    'label', ai.label,
    'runtime', ai.runtime,
    'default_scope_ref', ai.default_scope_ref,
    'active', ai.active,
    'active_token_count', (
      SELECT COUNT(*)::int
      FROM rye.agent_api_tokens tok
      WHERE tok.agent_id = ai.id
        AND tok.revoked_at IS NULL
        AND (tok.expires_at IS NULL OR tok.expires_at > now())
    ),
    'grants', (
      SELECT COALESCE(jsonb_agg(jsonb_build_object(
        'grant_id', g.id,
        'capability', g.capability,
        'domain_key', kd.domain_key,
        'scope_ref', g.scope_ref,
        'active', g.active,
        'expires_at', g.expires_at
      ) ORDER BY g.capability, kd.domain_key NULLS FIRST), '[]'::jsonb)
      FROM rye.agent_capability_grants g
      LEFT JOIN rye.knowledge_domains kd ON kd.id = g.domain_id
      WHERE g.agent_id = ai.id
    )
  ) ORDER BY ai.agent_key), '[]'::jsonb)
)
FROM rye.agent_identities ai, cfg;"
        return
      fi

      psql_exec "WITH cfg AS (SELECT set_config('app.current_role','admin',false))
SELECT
  ai.agent_key,
  ai.label,
  ai.runtime,
  ai.default_scope_ref,
  ai.active,
  (
    SELECT COUNT(*)::int
    FROM rye.agent_api_tokens tok
    WHERE tok.agent_id = ai.id
      AND tok.revoked_at IS NULL
      AND (tok.expires_at IS NULL OR tok.expires_at > now())
  ) AS active_token_count
FROM rye.agent_identities ai, cfg
ORDER BY ai.agent_key;

SELECT
  ai.agent_key,
  g.capability,
  kd.domain_key,
  g.scope_ref,
  g.active,
  g.expires_at
FROM rye.agent_capability_grants g
JOIN rye.agent_identities ai ON ai.id = g.agent_id
LEFT JOIN rye.knowledge_domains kd ON kd.id = g.domain_id
ORDER BY ai.agent_key, g.capability, kd.domain_key NULLS FIRST;"
      ;;
    audit)
      local limit=50
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --limit)
            limit="${2:-}"
            shift 2
            ;;
          -h|--help)
            cat <<'EOF'
Usage:
  ./scripts/rye agents audit [--limit <n>] [--json]
EOF
            return
            ;;
          *)
            die "Unknown agents audit option: $1"
            ;;
        esac
      done
      [[ "$limit" =~ ^[0-9]+$ ]] || die "agents audit --limit must be an integer."

      if [[ "$OUTPUT_JSON" -eq 1 ]]; then
        psql_json "SELECT jsonb_build_object(
  'actions', COALESCE(jsonb_agg(jsonb_build_object(
    'id', l.id,
    'agent_key', ai.agent_key,
    'action', l.action,
    'capability', l.capability,
    'domain_key', kd.domain_key,
    'scope_ref', l.scope_ref,
    'target_ref', l.target_ref,
    'allowed', l.allowed,
    'reason', l.reason,
    'created_at', l.created_at
  ) ORDER BY l.created_at DESC), '[]'::jsonb)
)
FROM (
  SELECT *
  FROM rye.agent_action_log
  ORDER BY created_at DESC
  LIMIT ${limit}
) l
LEFT JOIN rye.agent_identities ai ON ai.id = l.agent_id
LEFT JOIN rye.knowledge_domains kd ON kd.id = l.domain_id;"
        return
      fi

      psql_exec "SELECT
  l.created_at,
  ai.agent_key,
  l.action,
  l.capability,
  kd.domain_key,
  l.scope_ref,
  l.target_ref,
  l.allowed,
  l.reason
FROM rye.agent_action_log l
LEFT JOIN rye.agent_identities ai ON ai.id = l.agent_id
LEFT JOIN rye.knowledge_domains kd ON kd.id = l.domain_id
ORDER BY l.created_at DESC
LIMIT ${limit};"
      ;;
    -h|--help|help|"")
      cat <<'EOF'
Usage:
  ./scripts/rye agents create --key <agent-key> --label <name> [--runtime <runtime>] [--scope-ref <scope>]
  ./scripts/rye agents grant --key <agent-key> --capability <capability> [--domain <domain-key>] [--scope-ref <scope>] [--expires-at <iso-time>]
  ./scripts/rye agents issue-token --key <agent-key> [--label <label>] [--expires-at <iso-time>]
  ./scripts/rye agents revoke-token --token-id <uuid>
  ./scripts/rye agents list [--json]
  ./scripts/rye agents audit [--limit <n>] [--json]
EOF
      ;;
    *)
      die "Unknown agents command: $command"
      ;;
  esac
}

main() {
  parse_global_args "$@"
  set -- "${ARGS[@]}"

  local command="${1:-help}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  cd "$ROOT_DIR"

  case "$command" in
    init)
      cmd_init "$@"
      ;;
    local)
      cmd_local "$@"
      ;;
    remote)
      cmd_remote "$@"
      ;;
    onboard)
      cmd_onboard "$@"
      ;;
    plugins)
      cmd_plugins "$@"
      ;;
    catalog)
      cmd_catalog "$@"
      ;;
    context)
      cmd_context "$@"
      ;;
    sources)
      cmd_sources "$@"
      ;;
    agents)
      cmd_agents "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    doctor)
      cmd_doctor "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      die "Unknown command: $command"
      ;;
  esac
}

main "$@"
